{
  "name": "WeProjectManagement (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "64gb"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "WeProjectManagement",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "echo 'Codespace prêt : lancez  bash deploy/codespace.sh'"
}
