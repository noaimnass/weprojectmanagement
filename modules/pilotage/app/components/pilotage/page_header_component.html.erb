<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { title } %>
  <% header.with_breadcrumbs(breadcrumb_items) %>
  <% if description.present? %>
    <% header.with_description { description } %>
  <% end %>
  <% Array(actions).each do |action| %>
    <% header.with_action_button(scheme: action[:scheme] || :default,
                                 mobile_icon: action[:icon] || :link,
                                 mobile_label: action[:label],
                                 tag: :a,
                                 href: action[:href],
                                 target: action[:target],
                                 data: action[:data] || {}) do |button| %>
      <% button.with_leading_visual_icon(icon: action[:icon]) if action[:icon] %>
      <%= action[:label] %>
    <% end %>
  <% end %>
<% end %>
