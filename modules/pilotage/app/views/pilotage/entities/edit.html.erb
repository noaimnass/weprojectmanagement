<% html_title t("pilotage.label_organisation"), @entity.name %>
<%= render(Pilotage::PageHeaderComponent.new(title: "#{@entity.name} · #{t(:button_edit)}", breadcrumbs: [{ href: pilotage_entities_path, text: t("pilotage.label_organisation") }])) %>
<%= render partial: "pilotage/entities/form", locals: { entity: @entity } %>
<% if User.current.allowed_globally?(:manage_pilotage_portfolio) %>
  <p><%= link_to t(:button_delete), pilotage_entity_path(@entity), data: { turbo_method: :delete, turbo_confirm: t(:text_are_you_sure) }, class: "pilotage-muted" %></p>
<% end %>
