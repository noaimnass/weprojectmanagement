<% html_title @instance.name, @session.title %>
<%= render(Pilotage::PageHeaderComponent.new(title: "#{@session.title} · #{t(:button_edit)}", breadcrumbs: [{ href: pilotage_governance_path, text: t("pilotage.label_governance") }, { href: pilotage_instance_path(@instance), text: @instance.name }])) %>
