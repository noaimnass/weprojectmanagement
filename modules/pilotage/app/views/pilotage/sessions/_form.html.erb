<%# locals: session_item %>
<%= form_with model: session_item, url: (session_item.persisted? ? pilotage_instance_session_path(@instance, session_item) : pilotage_instance_sessions_path(@instance)), scope: :pilotage_session, class: "pilotage-form", data: { turbo: false } do |f| %>
  <% if session_item.errors.any? %><%= render(Primer::Alpha::Banner.new(scheme: :danger, mb: 3)) { session_item.errors.full_messages.join(", ") } %><% end %>
  <div class="pilotage-form__row">
    <%= render partial: "pilotage/shared/field", locals: { form: f, name: :title, label: t("pilotage.attributes.title"), required: true } %>
    <%= render partial: "pilotage/shared/field", locals: { form: f, name: :held_on, kind: :date, label: t("pilotage.attributes.held_on"), required: true } %>
    <%= render partial: "pilotage/shared/field", locals: { form: f, name: :state, kind: :select, options: Pilotage::Session::STATES.map { |s| [t("pilotage.governance.states.#{s}"), s] }, include_blank: false, label: t("pilotage.attributes.state") } %>
    <%= render partial: "pilotage/shared/field", locals: { form: f, name: :project_id, kind: :select, options: Project.allowed_to(User.current, :view_pilotage).active.order(:name).map { |p| [p.name, p.id] }, label: Project.model_name.human } %>
  </div>
  <%= render partial: "pilotage/shared/field", locals: { form: f, name: :agenda, kind: :textarea, label: t("pilotage.attributes.agenda"), rows: 5 } %>
  <%= render partial: "pilotage/shared/field", locals: { form: f, name: :minutes, kind: :textarea, label: t("pilotage.attributes.minutes"), rows: 8 } %>
  <div class="pilotage-form__actions">
    <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t(:button_save) } %>
    <%= render(Primer::Beta::Button.new(tag: :a, href: pilotage_instance_path(@instance))) { t(:button_cancel) } %>
  </div>
<% end %>
