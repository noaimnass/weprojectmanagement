<% html_title @project.name, t("pilotage.registers.import.title") %>
<%= render(Pilotage::PageHeaderComponent.new(title: "#{t('pilotage.registers.import.title')} · #{pilotage_kind_label(@kind)}", project: @project,
                                             breadcrumbs: [{ href: project_pilotage_register_items_path(@project, kind: @kind), text: pilotage_kind_label(@kind) }])) %>
<p><%= t("pilotage.registers.import.help") %></p>
<%= form_with url: import_project_pilotage_register_items_path(@project, kind: @kind), method: :post, multipart: true, class: "pilotage-form", data: { turbo: false } do |f| %>
  <div class="FormControl">
    <label class="FormControl-label" for="pilotage-import-file"><%= t("pilotage.registers.import.file") %></label>
    <%= f.file_field :file, id: "pilotage-import-file", accept: ".csv,text/csv", class: "FormControl-input" %>
  </div>
  <div class="pilotage-form__actions">
    <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t("pilotage.registers.import.preview") } %>
    <%= render(Primer::Beta::Button.new(tag: :a, href: export_project_pilotage_register_items_path(@project, kind: @kind))) { t("pilotage.registers.import.download_template") } %>
  </div>
<% end %>
