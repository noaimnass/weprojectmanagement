<%# locals: signals (Pilotage::Signals::Result) %>
<span class="pilotage-signals">
  <%= pilotage_signal_dot(signals.schedule, title: "#{t('pilotage.signals.schedule')}: #{t("pilotage.health.#{signals.schedule}")}") %>
  <%= pilotage_signal_dot(signals.budget, title: "#{t('pilotage.signals.budget')}: #{t("pilotage.health.#{signals.budget}")}") %>
  <%= pilotage_signal_dot(signals.risk, title: "#{t('pilotage.signals.risk')}: #{t("pilotage.health.#{signals.risk}")}") %>
  <%= pilotage_signal_dot(signals.reporting, title: "#{t('pilotage.signals.reporting')}: #{t("pilotage.health.#{signals.reporting}")}") %>
</span>
